# URL of the CCIP Read gateway (the Cloudflare Worker in /worker)
VITE_GATEWAY_URL=https://ens-gateway.gregskril.workers.dev

# WalletConnect project ID from https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Parent name to register subnames under. Must match PARENT_NAME in the
# Worker's wrangler.toml, which only accepts writes for subnames of it.
VITE_PARENT_NAME=offchaindemo.eth
